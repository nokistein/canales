<?xml version="1.0" encoding="utf-8"?>
<!-- No cloud/device-to-device backup of any app data: the sheets and history
     contain dispensation records tied to patients, so nothing here is eligible
     for Auto Backup or the transfer-to-new-device flow. -->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapability="true">
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </device-transfer>
</data-extraction-rules>
